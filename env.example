# Chave real da Anthropic (pega em console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Senha simples para proteger o proxy (invente uma qualquer, ex: um UUID)
# Sem isso, qualquer pessoa que descobrir a URL do proxy poderia usar sua chave.
APP_SECRET=escolha-uma-senha-aqui
